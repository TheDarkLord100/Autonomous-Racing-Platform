<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>simulation_bringup</name>
  <version>0.0.0</version>
  <description>One-command simulation bringup: scenario configs, ordered startup, per-run logging, RViz layout</description>
  <maintainer email="miracleyt404@gmail.com">thedarklord</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>rosbag2</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>f1tenth_gym_ros</exec_depend>
  <exec_depend>global_planner</exec_depend>
  <exec_depend>local_planner</exec_depend>
  <exec_depend>pure_pursuit</exec_depend>
  <exec_depend>particle_filter</exec_depend>
  <exec_depend>odom_noise</exec_depend>
  <exec_depend>race_eval</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
